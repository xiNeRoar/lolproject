# ─── Required ─────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/vclol
DISCORD_BOT_TOKEN=your-bot-token-here
DISCORD_CLIENT_ID=your-application-id-here

# ─── Optional (defaults shown) ────────────────────────────
PLATFORM_URL=https://vclol.gg
API_BASE_URL=http://localhost:3000
ROFL_UPLOAD_DIR=./uploads/rofl

# ─── For website OAuth (not needed for bot-only testing) ──
# DISCORD_CLIENT_SECRET=your-client-secret
# DISCORD_REDIRECT_URI=http://localhost:5173/auth/discord/callback

# ─── For Riot ID verification (Phase 2) ──────────────────
# RIOT_API_KEY=RGAPI-xxx
