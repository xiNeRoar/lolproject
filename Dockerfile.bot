# VCLoL Discord Bot — Docker image
# ARM64 + x86_64 compatible (Oracle Cloud ARM64 VPS)

FROM node:22-slim AS base
RUN npm install -g pnpm@10

# Install native deps for @napi-rs/canvas
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    python3 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy monorepo root config
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY tsconfig.base.json ./

# Copy only the packages the bot needs
COPY lib/db/ lib/db/
COPY lib/rofl-parse/ lib/rofl-parse/
COPY artifacts/discord-bot/ artifacts/discord-bot/

# Install deps
RUN pnpm install --frozen-lockfile || pnpm install --no-frozen-lockfile

# Build shared libs first, then bot
RUN cd lib/db && pnpm run build || true
RUN cd lib/rofl-parse && pnpm run build || true
RUN cd artifacts/discord-bot && pnpm run build || true

# Run with tsx (handles TypeScript directly, no build step needed)
WORKDIR /app/artifacts/discord-bot
CMD ["npx", "tsx", "src/index.ts"]
